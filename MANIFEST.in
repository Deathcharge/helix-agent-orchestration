include CHANGELOG.md
include CODE_OF_CONDUCT.md
include CONTRIBUTING.md
include LICENSE
include LICENSING.md
include NOTICE
include README.md
include SECURITY.md
include SUPPORT.md
include TRADEMARKS.md
include .github/CODEOWNERS
include .github/pull_request_template.md
recursive-include .github/ISSUE_TEMPLATE *.yml
